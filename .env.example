# Ashistanto local Azure configuration
# Copy this file to .env and replace only the values between <...>.
# Never commit or share the resulting .env file.

# PostgreSQL (when set, backend uses PostgreSQL instead of local SQLite)
DATABASE_URL=postgresql://ashistanto:change-me@localhost:5432/ashistanto
DATABASE_SSL=false
DATABASE_POOL_MAX=10
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Local UAT only; never enable this in production.
MOCK_AI=false

# Required for Azure Speech (speech-to-text and text-to-speech)
AZURE_SPEECH_KEY=<speech-resource-key>
AZURE_SPEECH_REGION=<azure-region>

# Required for Azure OpenAI
AZURE_OPENAI_KEY=<azure-openai-resource-key>
AZURE_OPENAI_ENDPOINT=https://<azure-openai-resource-name>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=<deployed-model-name>

# Required only when testing Microsoft 365 / Microsoft Graph integration.
# Register the redirect URI below in Microsoft Entra ID > App registrations.
MICROSOFT_CLIENT_ID=<application-client-id>
MICROSOFT_CLIENT_SECRET=<client-secret-value>
MICROSOFT_TENANT_ID=<directory-tenant-id>
REDIRECT_URI=http://localhost:3000/auth/callback
